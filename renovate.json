{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["kustomize"],
  "labels": ["dependencies", "gitops"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 4,
  "packageRules": [
    {
      "description": "Open PRs for backend image updates in the Kustomize production overlay",
      "matchManagers": ["kustomize"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/shynsg/todo-backend"],
      "matchFileNames": ["apps/backend-stack/overlays/prod/kustomization.yaml"],
      "versioning": "semver",
      "automerge": false,
      "commitMessageTopic": "todo-backend image",
      "branchTopic": "todo-backend-image"
    },
    {
      "description": "Open PRs for frontend image updates in the Kustomize production overlay",
      "matchManagers": ["kustomize"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/shynsg/todo-frontend"],
      "matchFileNames": ["apps/backend-stack/overlays/prod/kustomization.yaml"],
      "versioning": "semver",
      "automerge": false,
      "commitMessageTopic": "todo-frontend image",
      "branchTopic": "todo-frontend-image"
    },
    {
      "description": "Open PRs for notification image updates in the Kustomize production overlay",
      "matchManagers": ["kustomize"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/shynsg/todo-notification"],
      "matchFileNames": ["apps/backend-stack/overlays/prod/kustomization.yaml"],
      "versioning": "semver",
      "automerge": false,
      "commitMessageTopic": "todo-notification image",
      "branchTopic": "todo-notification-image"
    }
  ]
}
